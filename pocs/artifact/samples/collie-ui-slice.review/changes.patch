+const meta = { title: "Primitives/Layout" } satisfies Meta;
+export default meta;
+
+function Swatch({ children }: { children: React.ReactNode }) {
+  return (
+    <Box background="accent" padding="100" radius="sm">
+      <Text size="xs" tone="accent">
+        {children}
+      </Text>
+    </Box>
+  );
+}
