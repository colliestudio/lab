++package retry
++
++import (
++	"math"
++	"math/rand/v2"
++	"time"
++)
++
++// Policy is a capped exponential backoff with full jitter.
++// Attempt 1 is the first retry (the original delivery is attempt 0).
++type Policy struct {
++	Base        time.Duration // delay before the first retry
++	Max         time.Duration // cap for a single delay
++	MaxAttempts int           // give up after this many retries
++}
++
++// DefaultPolicy: 30s, 1m, 2m, 4m ... capped at 1h, 12 retries (~9h total).
++var DefaultPolicy = Policy{
++	Base:        30 * time.Second,
++	Max:         time.Hour,
++	MaxAttempts: 12,
++}
++
++// Delay returns how long to wait before retry `attempt`, or ok=false when
++// the policy is exhausted and the delivery should be marked failed.
++func (p Policy) Delay(attempt int) (d time.Duration, ok bool) {
++	if attempt < 1 || attempt > p.MaxAttempts {
++		return 0, false
++	}
++	exp := float64(p.Base) * math.Pow(2, float64(attempt-1))
++	if exp > float64(p.Max) {
++		exp = float64(p.Max)
++	}
++	// full jitter: uniform in [exp/2, exp] keeps retries spread without
++	// collapsing to near-zero delays.
++	half := exp / 2
++	return time.Duration(half + rand.Float64()*half), true
++}
++
++// Exhausted reports whether no retries are left after `attempt`.
++func (p Policy) Exhausted(attempt int) bool { return attempt >= p.MaxAttempts }
+diff --git a/internal/retry/scheduler.go b/internal/retry/scheduler.go
+new file mode 100644
+index 0000000..9a0b7d1
+--- /dev/null
++++ b/internal/retry/scheduler.go
+@@ -0,0 +1,52 @@
++package retry
++
++import (
++	"context"
++	"fmt"
++	"time"
++
++	"github.com/acme/relay/internal/deliverymq"
++	"github.com/acme/relay/internal/models"
++)
++
++// Scheduler re-enqueues failed deliveries after their backoff delay.
++// It relies on the queue's native delayed publish, so there is no
++// polling loop and no extra table to scan.
++type Scheduler struct {
++	queue  deliverymq.Publisher
++	policy Policy
++	now    func() time.Time
++}
++
++func NewScheduler(q deliverymq.Publisher, p Policy) *Scheduler {
++	return &Scheduler{queue: q, policy: p, now: time.Now}
++}
++
++// Outcome tells the consumer what happened to a failed delivery.
++type Outcome int
++
++const (
++	Scheduled Outcome = iota // a retry is queued
++	GaveUp                   // policy exhausted; mark the delivery failed
++)
++
++// Schedule queues the next attempt for d, or reports GaveUp.
++func (s *Scheduler) Schedule(ctx context.Context, d models.Delivery) (Outcome, time.Time, error) {
++	next := d.Attempt + 1
++	delay, ok := s.policy.Delay(next)
++	if !ok {
++		return GaveUp, time.Time{}, nil
++	}
++	at := s.now().Add(delay)
++	msg := d.WithAttempt(next)
++	if err := s.queue.PublishAt(ctx, msg, at); err != nil {
++		return 0, time.Time{}, fmt.Errorf("retry: publish attempt %d of %s: %w", next, d.ID, err)
++	}
++	return Scheduled, at, nil
++}
++
++// Replay queues an immediate attempt for a delivery that already gave up.
++// Used by the operator API; it does not reset the attempt counter.
++func (s *Scheduler) Replay(ctx context.Context, d models.Delivery) error {
++	return s.queue.PublishAt(ctx, d.WithAttempt(d.Attempt+1), s.now())
++}
