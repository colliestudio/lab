@@ -0,0 +1,122 @@
+// Bundle file access (dir or zip), the files a doc references, and comment storage.
+import { existsSync, readFileSync, readdirSync, renameSync, statSync, writeFileSync } from "node:fs";
+import { join, posix } from "node:path";
+import { randomBytes } from "node:crypto";
+import { unzipSync, zipSync } from "fflate";
+import type { Comment, Doc } from "../model.ts";
+
+export interface BundleReader {
+  isDir: boolean;
+  read(path: string): Uint8Array | undefined;
+  list(): string[];
+}
+
+/** Normalizes a bundle-relative path; null if it escapes the bundle. */
+export function safePath(p: string): string | null {
+  const n = posix.normalize(p.replace(/\\/g, "/")).replace(/^(\.\/|\/)+/, "");
+  if (!n || n === "." || n === ".." || n.startsWith("../") || n.includes("\0")) return null;
+  return n;
+}
+
+export function openBundle(path: string): BundleReader {
+  if (statSync(path).isDirectory()) {
+    return {
+      isDir: true,
+      read(p) {
+        const s = safePath(p);
+        if (!s) return undefined;
+        try { return readFileSync(join(path, s)); } catch { return undefined; }
+      },
+      list: () => (readdirSync(path, { recursive: true }) as string[])
+        .map((p) => p.split("\\").join("/")).filter((p) => statSync(join(path, p)).isFile()),
+    };
+  }
+  return zipReader(readFileSync(path));
+}
+
+export function zipReader(zip: Uint8Array): BundleReader {
+  const files = unzipSync(zip);
+  return {
+    isDir: false,
+    read: (p) => { const s = safePath(p); return s ? files[s] : undefined; },
+    list: () => Object.keys(files).filter((f) => !f.endsWith("/")),
+  };
+}
+
+/** Bundle paths the doc points at: demo blocks, before-after shots, markdown images/links. */
+export function referencedFiles(doc: Doc, bundle: BundleReader): string[] {
+  const refs = new Set<string>();
+  const md: string[] = [doc.overview];
+  const blocks = [{ summary: "", blocks: doc.overviewBlocks ?? [] }, ...doc.sections];
+  for (const s of blocks) {
+    md.push(s.summary);
+    for (const b of s.blocks) {
+      if (b.type === "demo") refs.add(b.src);
+      else if (b.type === "before-after") for (const shot of [b.before, b.after]) { if (shot.src) refs.add(shot.src); if (shot.demo) refs.add(shot.demo); }
+      else if (b.type === "markdown" || b.type === "callout") md.push(b.md);
+    }
+  }
+  for (const text of md) for (const m of (text ?? "").matchAll(/\]\(\s*<?([^)\s>]+)|\bsrc=["']([^"']+)/g)) refs.add(m[1] ?? m[2]);
+  const out: string[] = [];
+  for (const r of refs) {
+    let s: string | null = null;
+    try { s = r && !/^[a-z]+:/i.test(r) ? safePath(decodeURI(r.split(/[?#]/)[0])) : null; } catch { /* bad escape */ }
+    if (s && bundle.read(s)) out.push(s);
+  }
+  return [...new Set(out)].sort();
+}
+
+/** Drops trace.zip (usually ~95% of a .replay) for inlining; the viewer only needs the JSON streams. */
+export function slimReplay(bytes: Uint8Array): Uint8Array {
+  try {
+    const files = unzipSync(bytes, { filter: (f) => f.name !== "trace.zip" });
+    return zipSync(files, { level: 6 });
+  } catch { return bytes; }
+}
+
+// ---- comments ----
+
+/** Dir bundle: comments.json inside it. Zip bundle: sidecar `<bundle>.comments.json` next to it. */
+export function commentsFile(bundlePath: string): string {
+  return statSync(bundlePath).isDirectory() ? join(bundlePath, "comments.json") : bundlePath + ".comments.json";
+}
+
+export function readComments(file: string, fallback?: BundleReader): Comment[] {
+  try {
+    if (existsSync(file)) return JSON.parse(readFileSync(file, "utf8"));
+    const inZip = fallback?.read("comments.json");
+    if (inZip) return JSON.parse(new TextDecoder().decode(inZip));
+  } catch { /* corrupt file: treat as empty */ }
+  return [];
+}
+
+/** Validates a POSTed comment (Comment without id/created) and fills id + created. */
+export function newComment(input: unknown): Comment {
+  const c = (input ?? {}) as Partial<Comment>;
+  if (typeof c.body !== "string" || !c.body.trim()) throw new Error("body required");
+  if (c.body.length > 20_000) throw new Error("body too long");
+  const a = (typeof c.anchor === "object" && c.anchor) || {};
+  const anchor: Comment["anchor"] = {};
+  if (typeof a.section === "string") anchor.section = a.section;
+  if (typeof a.block === "string") anchor.block = a.block;
+  if (typeof a.file === "string") anchor.file = a.file;
+  if (typeof a.line === "number") anchor.line = a.line;
+  return {
+    id: randomBytes(5).toString("hex"), anchor,
+    author: typeof c.author === "string" && c.author.trim() ? c.author.trim().slice(0, 100) : "anonymous",
+    body: c.body, created: new Date().toISOString(),
+    ...(c.resolved === true ? { resolved: true } : {}),
+  };
+}
+
+export function appendComment(file: string, c: Comment, fallback?: BundleReader): Comment[] {
+  const all = [...readComments(file, fallback), c];
+  writeJsonAtomic(file, all);
+  return all;
+}
+
+export function writeJsonAtomic(file: string, value: unknown): void {
+  const tmp = `${file}.${randomBytes(4).toString("hex")}.tmp`;
+  writeFileSync(tmp, JSON.stringify(value, null, 2) + "\n");
+  renameSync(tmp, file);
+}
diff --git a/src/server/hosted.ts b/src/server/hosted.ts
new file mode 100644
index 0000000..3bdd764
--- /dev/null
+++ b/src/server/hosted.ts
@@ -0,0 +1,131 @@
+// `recap server`: hosted / self-hosted. Upload = zip bundle; unlisted random ids; comments server-side.
+// Storage per doc: <data>/<id>/{bundle.review (zip), doc.json, meta.json, comments.json}.
+import { createServer, type IncomingMessage } from "node:http";
+import { existsSync, mkdirSync, readFileSync, readdirSync, renameSync, rmSync, writeFileSync } from "node:fs";
+import { join, resolve } from "node:path";
+import { randomBytes, timingSafeEqual } from "node:crypto";
+import type { AddressInfo } from "node:net";
+import type { Doc } from "../model.ts";
+import { loadBundle } from "../parse/index.ts";
+import { appendComment, readComments, writeJsonAtomic, zipReader, type BundleReader } from "./bundle.ts";
+import { guard, handleApi, injectBoot, readBody, send, sendJson, viewerTemplate } from "./http.ts";
+import type { Running } from "./serve.ts";
+
+const ID_RE = /^[A-Za-z0-9]{10}$/;
+const ALPHABET = "abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789"; // no look-alikes
+export const newId = () => [...randomBytes(10)].map((b) => ALPHABET[b % ALPHABET.length]).join("");
+
+interface Meta { id: string; title: string; kind: string; created: string; updated: string }
+
+export async function startHosted(opts: { data: string; port?: number; host?: string; token?: string }): Promise<Running> {
+  const data = resolve(opts.data);
+  mkdirSync(data, { recursive: true });
+  const cache = new Map<string, { doc: Doc; reader: BundleReader }>();
+
+  const tokenOk = (s: string | null | undefined) => {
+    const got = Buffer.from(s ?? ""), want = Buffer.from(opts.token ?? "");
+    return want.length > 0 && got.length === want.length && timingSafeEqual(got, want);
+  };
+  const authorized = (req: IncomingMessage) => !opts.token || tokenOk(/^Bearer (.+)$/.exec(req.headers.authorization ?? "")?.[1]);
+
+  /** Parses the upload, then swaps it in; comments.json is left alone (re-publish keeps comments). */
+  async function store(id: string, zip: Buffer, isNew: boolean): Promise<Meta> {
+    const dir = join(data, id);
+    mkdirSync(dir, { recursive: true });
+    const tmp = join(dir, `upload-${randomBytes(4).toString("hex")}.review`);
+    writeFileSync(tmp, zip);
+    let doc: Doc;
+    try {
+      zipReader(zip); // rejects non-zip bodies with a clear error before the parser sees them
+      doc = (await loadBundle(tmp)).doc;
+    } catch (e) {
+      rmSync(tmp, { force: true });
+      if (isNew) rmSync(dir, { recursive: true, force: true });
+      throw Object.assign(new Error(`invalid bundle: ${(e as Error).message}`), { status: 400 });
+    }
+    renameSync(tmp, join(dir, "bundle.review"));
+    writeJsonAtomic(join(dir, "doc.json"), doc);
+    const now = new Date().toISOString();
+    const prev = isNew ? undefined : readMeta(id);
+    const meta: Meta = { id, title: doc.title, kind: doc.kind, created: prev?.created ?? now, updated: now };
+    writeJsonAtomic(join(dir, "meta.json"), meta);
+    cache.delete(id);
+    return meta;
+  }
+  const readMeta = (id: string): Meta | undefined => {
+    try { return JSON.parse(readFileSync(join(data, id, "meta.json"), "utf8")); } catch { return undefined; }
+  };
+  const open = (id: string) => {
+    if (!ID_RE.test(id) || !existsSync(join(data, id, "doc.json"))) return undefined;
+    let hit = cache.get(id);
+    if (!hit) {
+      hit = { doc: JSON.parse(readFileSync(join(data, id, "doc.json"), "utf8")), reader: zipReader(readFileSync(join(data, id, "bundle.review"))) };
+      cache.set(id, hit);
+    }
+    return hit;
+  };
+  const docUrl = (req: IncomingMessage, id: string) => {
+    const proto = (req.headers["x-forwarded-proto"] as string | undefined)?.split(",")[0] ?? "http";
+    return `${proto}://${req.headers.host}/d/${id}`;
+  };
+
+  const server = createServer(guard(async (req, res) => {
+    const url = new URL(req.url ?? "/", "http://x");
+    const p = url.pathname, m = req.method ?? "GET";
+
+    if (p === "/api/docs" && m === "POST") {
+      if (!authorized(req)) return sendJson(res, 401, { error: "unauthorized" });
+      const body = await readBody(req);
+      let id = newId();
+      while (existsSync(join(data, id))) id = newId();
+      await store(id, body, true);
+      return sendJson(res, 201, { id, url: docUrl(req, id) });
+    }
+    let r = /^\/api\/docs\/([^/]+)$/.exec(p);
+    if (r && m === "PUT") {
+      if (!authorized(req)) return sendJson(res, 401, { error: "unauthorized" });
+      if (!open(r[1])) return sendJson(res, 404, { error: "no such doc" });
+      await store(r[1], await readBody(req), false);
+      return sendJson(res, 200, { id: r[1], url: docUrl(req, r[1]) });
+    }
+
+    r = /^\/d\/([^/]+)(\/.*)?$/.exec(p);
+    if (r) {
+      const id = r[1], rest = r[2] ?? "", hit = open(id);
+      if (!hit) return send(res, 404, "not found");
+      const noindex = { "x-robots-tag": "noindex", "referrer-policy": "no-referrer" };
+      if (rest === "" || rest === "/") {
+        return send(res, 200, injectBoot(viewerTemplate(), { doc: hit.doc, api: `/d/${id}/api` }), "text/html; charset=utf-8", noindex);
+      }
+      if (rest.startsWith("/api/")) {
+        const cFile = join(data, id, "comments.json");
+        const handled = await handleApi(req, res, rest.slice(5), {
+          doc: () => hit.doc,
+          file: (f) => hit.reader.read(f),
+          comments: () => readComments(cFile, hit.reader),
+          addComment: (c) => { appendComment(cFile, c, hit.reader); },
+        });
+        if (handled) return;
+      }
+      return send(res, 404, "not found");
+    }
+
+    // Index: unlisted by default; only with ?token=<server token>.
+    if (p === "/" && tokenOk(url.searchParams.get("token"))) {
+      const metas = readdirSync(data).filter((d) => ID_RE.test(d)).map(readMeta).filter((x): x is Meta => !!x)
+        .sort((a, b) => b.updated.localeCompare(a.updated));
+      const esc = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
+      const rows = metas.map((x) => `<li><a href="/d/${x.id}">${esc(x.title)}</a> <small>${esc(x.kind)} · ${esc(x.updated)}</small></li>`).join("");
+      return send(res, 200, `<!doctype html><meta charset="utf-8"><title>recap docs</title><body style="font:14px system-ui;margin:24px"><h1>docs (${metas.length})</h1><ul>${rows}</ul>`,
+        "text/html; charset=utf-8", { "x-robots-tag": "noindex" });
+    }
+    send(res, 404, "not found");
+  }));
+
+  await new Promise<void>((ok, err) => { server.once("error", err); server.listen(opts.port ?? 0, opts.host ?? "127.0.0.1", ok); });
+  const { port } = server.address() as AddressInfo;
+  return {
+    url: `http://${opts.host === "0.0.0.0" ? "127.0.0.1" : opts.host ?? "127.0.0.1"}:${port}/`,
+    close: () => new Promise<void>((ok) => { server.close(() => ok()); server.closeAllConnections(); }),
+  };
+}
diff --git a/src/server/http.ts b/src/server/http.ts
new file mode 100644
index 0000000..81ce9ef
--- /dev/null
+++ b/src/server/http.ts
@@ -0,0 +1,104 @@
+// Shared HTTP bits: responses, the doc API (GET doc / files/<path> / comments, POST comments), viewer page.
+import type { IncomingMessage, ServerResponse } from "node:http";
+import { existsSync, readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { join } from "node:path";
+import type { Comment, Doc, ViewerBoot } from "../model.ts";
+import { newComment, safePath } from "./bundle.ts";
+import { execFileSync } from "node:child_process";
+
+const ROOT = fileURLToPath(new URL("../../", import.meta.url));
+const VIEWER_DIST = join(ROOT, "viewer/dist/index.html");
+export const BOOT_MARKER = "<!--RECAP_BOOT-->";
+
+const MIME: Record<string, string> = {
+  png: "image/png", jpg: "image/jpeg", jpeg: "image/jpeg", gif: "image/gif", webp: "image/webp", svg: "image/svg+xml",
+  json: "application/json", md: "text/markdown; charset=utf-8", txt: "text/plain; charset=utf-8",
+  patch: "text/x-diff; charset=utf-8", diff: "text/x-diff; charset=utf-8", html: "text/html; charset=utf-8",
+  css: "text/css", js: "text/javascript", replay: "application/zip", zip: "application/zip", mp4: "video/mp4", webm: "video/webm",
+};
+export const mimeOf = (p: string) => MIME[p.split(".").pop()!.toLowerCase()] ?? "application/octet-stream";
+
+export function send(res: ServerResponse, status: number, body: string | Uint8Array, type = "text/plain; charset=utf-8", headers: Record<string, string> = {}) {
+  res.writeHead(status, { "content-type": type, "content-length": Buffer.byteLength(body), ...headers });
+  res.end(body);
+}
+export const sendJson = (res: ServerResponse, status: number, value: unknown) =>
+  send(res, status, JSON.stringify(value), "application/json; charset=utf-8");
+
+export async function readBody(req: IncomingMessage, limit = 100 * 1024 * 1024): Promise<Buffer> {
+  const chunks: Buffer[] = [];
+  let n = 0;
+  for await (const c of req) {
+    n += c.length;
+    if (n > limit) throw Object.assign(new Error("body too large"), { status: 413 });
+    chunks.push(c);
+  }
+  return Buffer.concat(chunks);
+}
+
+/** The viewer's HTML (viewer/dist/index.html, one self-contained file). Builds it once if missing. */
+export function viewerTemplate(): string {
+  if (!existsSync(VIEWER_DIST)) {
+    const vite = join(ROOT, "node_modules/vite/bin/vite.js");
+    process.stderr.write("recap: viewer/dist missing, building the viewer (pnpm viewer:build)…\n");
+    try {
+      execFileSync(process.execPath, [vite, "build", "--config", join(ROOT, "viewer/vite.config.ts"), "--logLevel", "warn"],
+        { cwd: ROOT, stdio: ["ignore", 2, 2] });
+    } catch { /* reported below */ }
+    if (!existsSync(VIEWER_DIST)) throw new Error("viewer not built and the automatic build failed; run `pnpm viewer:build` in the recap-lab repo");
+  }
+  return readFileSync(VIEWER_DIST, "utf8");
+}
+
+/** JSON safe inside <script> (no `</script>` / `<!--`); U+2028/9 are legal in JS strings since ES2019. */
+const scriptJson = (v: unknown) => JSON.stringify(v).replace(/</g, "\\u003c");
+
+/** Injects window.__RECAP__ at the marker (or before </head>); `events` adds a live-reload EventSource. */
+export function injectBoot(html: string, boot: ViewerBoot, events?: string): string {
+  let tag = `<script>window.__RECAP__=${scriptJson(boot)}</script>`;
+  if (events) tag += `<script>new EventSource(${scriptJson(events)}).addEventListener("reload",()=>location.reload())</script>`;
+  if (html.includes(BOOT_MARKER)) return html.replace(BOOT_MARKER, () => tag);
+  return html.includes("</head>") ? html.replace("</head>", () => tag + "</head>") : tag + html;
+}
+
+export interface DocSource {
+  doc(): Doc;
+  file(path: string): Uint8Array | undefined;
+  comments(): Comment[];
+  addComment(c: Comment): void;
+}
+
+/** Handles `${api}/<sub>`; returns false if `sub` isn't an API route. */
+export async function handleApi(req: IncomingMessage, res: ServerResponse, sub: string, src: DocSource): Promise<boolean> {
+  const m = req.method ?? "GET";
+  if (sub === "doc" && m === "GET") { sendJson(res, 200, src.doc()); return true; }
+  if (sub.startsWith("files/") && (m === "GET" || m === "HEAD")) {
+    let p: string | null = null;
+    try { p = safePath(decodeURIComponent(sub.slice(6))); } catch { /* bad escape */ }
+    const bytes = p ? src.file(p) : undefined;
+    if (!p || !bytes) { send(res, 404, "not found"); return true; }
+    send(res, 200, bytes, mimeOf(p), { "cache-control": "no-cache" });
+    return true;
+  }
+  if (sub === "comments" && m === "GET") { sendJson(res, 200, src.comments()); return true; }
+  if (sub === "comments" && m === "POST") {
+    let c: Comment;
+    try { c = newComment(JSON.parse((await readBody(req, 1024 * 1024)).toString("utf8"))); }
+    catch (e) { sendJson(res, 400, { error: (e as Error).message }); return true; }
+    src.addComment(c);
+    sendJson(res, 201, c);
+    return true;
+  }
+  return false;
+}
+
+/** Wraps a handler: errors → 500/413 JSON instead of a crashed process. */
+export function guard(fn: (req: IncomingMessage, res: ServerResponse) => Promise<void>) {
+  return (req: IncomingMessage, res: ServerResponse) => {
+    fn(req, res).catch((e) => {
+      if (!res.headersSent) sendJson(res, (e as { status?: number }).status ?? 500, { error: (e as Error).message });
+      else res.end();
+    });
+  };
+}
diff --git a/src/server/index.ts b/src/server/index.ts
new file mode 100644
index 0000000..0f86558
--- /dev/null
+++ b/src/server/index.ts
@@ -0,0 +1,83 @@
+// Entry for `recap serve | build | server | publish` (src/cli.ts dynamic-imports this and calls run).
+import { writeFileSync } from "node:fs";
+import { spawn } from "node:child_process";
+import { buildHtml } from "./build.ts";
+import { startHosted } from "./hosted.ts";
+import { publish } from "./publish.ts";
+import { startServe, type Running } from "./serve.ts";
+
+export { buildHtml, startHosted, publish, startServe };
+
+const USAGE = `usage:
+  recap serve <bundle> [--port N] [--open]
+  recap build <bundle> -o out.html
+  recap server --data <dir> [--port N] [--host H] [--token T]
+  recap publish <bundle> --to <url> [--token T] [--id <id>]`;
+
+function parseArgs(args: string[]) {
+  const pos: string[] = [], flags: Record<string, string | true> = {};
+  for (let i = 0; i < args.length; i++) {
+    const a = args[i];
+    const m = /^--?([\w-]+)(?:=(.*))?$/.exec(a);
+    if (!m) { pos.push(a); continue; }
+    if (m[2] !== undefined) flags[m[1]] = m[2];
+    else if (m[1] === "open") flags.open = true;
+    else if (i + 1 < args.length) flags[m[1]] = args[++i];
+    else flags[m[1]] = true;
+  }
+  const str = (k: string) => (typeof flags[k] === "string" ? (flags[k] as string) : undefined);
+  const port = str("port") ? Number(str("port")) : undefined;
+  if (port !== undefined && !Number.isInteger(port)) throw new Error("--port must be a number");
+  return { pos, flags, str, port };
+}
+
+/** Resolves on SIGINT/SIGTERM after closing the server. */
+function untilSignal(r: Running): Promise<number> {
+  return new Promise((ok) => {
+    const stop = () => { r.close().then(() => ok(0)); };
+    process.once("SIGINT", stop);
+    process.once("SIGTERM", stop);
+  });
+}
+
+export async function run(cmd: string, args: string[]): Promise<number> {
+  try {
+    const { pos, flags, str, port } = parseArgs(args);
+    switch (cmd) {
+      case "serve": {
+        if (!pos[0]) break;
+        const r = await startServe(pos[0], { port });
+        console.log(`serving ${pos[0]} at ${r.url}  (Ctrl-C to stop)`);
+        if (flags.open) spawn(process.platform === "darwin" ? "open" : process.platform === "win32" ? "explorer" : "xdg-open", [r.url], { stdio: "ignore", detached: true }).unref();
+        return untilSignal(r);
+      }
+      case "build": {
+        const out = str("o") ?? str("out");
+        if (!pos[0] || !out) break;
+        const { html, files } = await buildHtml(pos[0]);
+        writeFileSync(out, html);
+        console.log(`wrote ${out} (${(Buffer.byteLength(html) / 1024).toFixed(0)} KB, ${files.length} file${files.length === 1 ? "" : "s"} inlined)`);
+        return 0;
+      }
+      case "server": {
+        const data = str("data");
+        if (!data) break;
+        const r = await startHosted({ data, port, host: str("host"), token: str("token") ?? process.env.RECAP_TOKEN });
+        console.log(`recap server on ${r.url}  data=${data}${str("token") || process.env.RECAP_TOKEN ? "  (token required to publish)" : ""}`);
+        return untilSignal(r);
+      }
+      case "publish": {
+        const to = str("to");
+        if (!pos[0] || !to) break;
+        const r = await publish(pos[0], { to, token: str("token") ?? process.env.RECAP_TOKEN, id: str("id") });
+        console.log(r.url);
+        return 0;
+      }
+    }
+    console.error(USAGE);
+    return 2;
+  } catch (e) {
+    console.error(`recap ${cmd}: ${(e as Error).message}`);
+    return 1;
+  }
+}
