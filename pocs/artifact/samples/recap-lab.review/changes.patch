++	// Failed: hand the delivery to the retry scheduler, then ack the original.
++	// Ack only after the retry is safely queued, so a crash in between re-delivers
++	// (a duplicate attempt) instead of dropping the event.
++	outcome, at, err := c.retries.Schedule(ctx, d)
++	if err != nil {
++		c.log.Error("schedule retry", "delivery", d.ID, "err", err)
++		return msg.Nack()
++	}
++	switch outcome {
++	case retry.Scheduled:
++		c.metrics.Retried.Inc()
++		c.log.Info("retry scheduled", "delivery", d.ID, "attempt", d.Attempt+1, "at", at)
++	case retry.GaveUp:
++		c.metrics.Failed.Inc()
++		if err := c.attempts.MarkFailed(ctx, d.ID); err != nil {
++			c.log.Warn("mark failed", "delivery", d.ID, "err", err)
++		}
++	}
++	return msg.Ack()
+ }
