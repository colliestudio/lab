+      "id": "retry",
+      "title": "Retry scheduler",
+      "summary": "New `RetryScheduler`: capped exponential backoff with full jitter. Defaults are 30s base, 1h cap, 8 attempts, so a destination that is down for about 2 hours still gets every event.",
+      "mechanical": false,
+      "blocks": [
+        {
+          "id": "retry-code-1",
+          "level": 3,
+          "type": "code",
+          "code": "// Next returns when attempt+1 should run, or ok=false when attempts are exhausted.\nfunc (r *RetryScheduler) Next(attempt int, now time.Time) (at time.Time, ok bool) {\n\tif attempt >= r.MaxAttempts {\n\t\treturn time.Time{}, false\n\t}\n\td := r.Base << attempt\n\tif d <= 0 || d > r.Cap {\n\t\td = r.Cap\n\t}\n\tjitter := time.Duration(rand.Int64N(int64(d)))\n\treturn now.Add(jitter), true\n}",
+          "lang": "go",
+          "file": "internal/delivery/retry.go"
+        },
+        {
+          "id": "retry-callout-1",
+          "level": 2,
+          "type": "callout",
+          "tone": "decision",
+          "md": "Full jitter (uniform in `[0, d)`) over equal jitter: it spreads a burst of failures from one outage better, at the cost of an occasional very short first retry."
+        },
+        {
+          "id": "retry-questions-1",
+          "level": 0,
+          "type": "questions",
