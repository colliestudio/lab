diff --git a/viewer/src/App.tsx b/viewer/src/App.tsx
new file mode 100644
index 0000000..1b0911c
--- /dev/null
+++ b/viewer/src/App.tsx
@@ -0,0 +1,406 @@
+import { useCallback, useEffect, useLayoutEffect, useMemo, useRef, useState } from "react";
+import type { Comment, Doc, Level, ViewerBoot } from "../../src/model.ts";
+import { Ctx, useViewer, type ViewerCtx } from "./ctx.tsx";
+import { commentsApi, makeGetFile } from "./boot.ts";
+import { Headline } from "./components/Headline.tsx";
+import { MapView } from "./components/MapView.tsx";
+import { Markdown } from "./components/Markdown.tsx";
+import { SectionView, autoFiles, explicitDiffFiles } from "./components/SectionView.tsx";
+import { FileTree } from "./blocks/files.tsx";
+import { FileDiff } from "./blocks/diff.tsx";
+import { Icon } from "./components/icons.tsx";
+import { Commentable } from "./components/Comments.tsx";
+import { BlockView } from "./blocks/index.tsx";
+import { LEVELS, cx, diffId, nodeForSection, orderedSections, plural, sectionDomId } from "./util.ts";
+
+type Theme = "light" | "dark";
+const clampLevel = (n: number) => Math.max(0, Math.min(3, n)) as Level;
+
+function readHash(): { level: Level; focus: string | null } {
+  const m = location.hash.match(/^#\/L([0-3])(?:\/(.+))?$/);
+  return m ? { level: Number(m[1]) as Level, focus: m[2] ? decodeURIComponent(m[2]) : null } : { level: 1, focus: null };
+}
+
+const systemTheme = (): Theme => (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
+
+export function App({ boot }: { boot: ViewerBoot }) {
+  const doc = boot.doc;
+  const getFile = useMemo(() => makeGetFile(boot), [boot]);
+  const initial = useMemo(readHash, []);
+  const [level, setLevelRaw] = useState<Level>(initial.level);
+  const [focus, setFocusRaw] = useState<string | null>(initial.focus);
+  const [themePref, setThemePref] = useState<Theme | null>(() => (localStorage.getItem("recap.theme") as Theme) || null);
+  const [sysTheme, setSysTheme] = useState<Theme>(systemTheme);
+  const theme = themePref ?? sysTheme;
+  const [overlay, setOverlay] = useState(false);
+  const [comments, setComments] = useState<Comment[]>([]);
+  const scrollAnchor = useRef<{ id: string; top: number } | null>(null);
+
+  useEffect(() => {
+    const mq = matchMedia("(prefers-color-scheme: dark)");
+    const on = () => setSysTheme(systemTheme());
+    mq.addEventListener("change", on);
+    return () => mq.removeEventListener("change", on);
+  }, []);
+  useLayoutEffect(() => {
+    const el = document.documentElement;
+    if (theme === "dark") el.dataset.theme = "midnight"; else delete el.dataset.theme;
+    el.style.colorScheme = theme;
+  }, [theme]);
+  useEffect(() => { document.title = `${doc.title} · ${doc.kind === "plan" ? "plan" : "review"}`; }, [doc]);
+
+  // --- level changes keep the reader's place: remember the first visible section and restore its offset
+  const setLevel = useCallback((l: Level) => {
+    const secs = [...document.querySelectorAll<HTMLElement>("[data-section], #map-panel, #headline")];
+    const top = 64;
+    const cur = secs.find((s) => s.getBoundingClientRect().bottom > top + 8);
+    scrollAnchor.current = cur ? { id: cur.id, top: cur.getBoundingClientRect().top } : null;
+    setLevelRaw(clampLevel(l));
+  }, []);
+  useLayoutEffect(() => {
+    const a = scrollAnchor.current;
+    scrollAnchor.current = null;
+    if (!a) return;
+    const el = document.getElementById(a.id);
+    if (el) window.scrollBy(0, el.getBoundingClientRect().top - a.top);
+  }, [level]);
+
+  const setFocus = useCallback((id: string | null) => {
+    setFocusRaw(id);
+    if (id) setLevelRaw((l) => (l < 2 ? 2 : l));
+    window.scrollTo(0, 0);
+    if (!id) requestAnimationFrame(() => document.getElementById("map-panel")?.scrollIntoView({ block: "start" }));
+  }, []);
+
+  // hash <-> state (focus pushes history so Back leaves focus)
+  const lastFocus = useRef(focus);
+  useEffect(() => {
+    const h = `#/L${level}${focus ? "/" + encodeURIComponent(focus) : ""}`;
+    if (location.hash === h) return;
+    if (focus !== lastFocus.current) history.pushState(null, "", h); else history.replaceState(null, "", h);
+    lastFocus.current = focus;
+  }, [level, focus]);
+  useEffect(() => {
+    const on = () => { const s = readHash(); lastFocus.current = s.focus; setLevelRaw(s.level); setFocusRaw(s.focus); };
+    window.addEventListener("popstate", on);
+    return () => window.removeEventListener("popstate", on);
+  }, []);
+
+  const revealFile = useCallback((path: string) => {
+    const go = (tries: number) => {
+      window.dispatchEvent(new CustomEvent("recap:reveal", { detail: path }));
+      requestAnimationFrame(() => requestAnimationFrame(() => {
+        const el = document.getElementById(diffId(path));
+        if (!el) {
+          if (tries > 0) { setFocusRaw(null); setLevelRaw(3); setTimeout(() => go(tries - 1), 60); }
+          return;
+        }
+        // diffs that just mounted (e.g. inside a mechanical section that opened) missed the first event
+        window.dispatchEvent(new CustomEvent("recap:reveal", { detail: path }));
+        requestAnimationFrame(() => {
+          el.scrollIntoView({ behavior: "smooth", block: "start" });
+          el.classList.remove("flash"); void el.offsetWidth; el.classList.add("flash");
+        });
+      }));
+    };
+    go(2);
+  }, []);
+
+  // comments
+  const reloadComments = useCallback(() => { if (boot.api) commentsApi.list(boot.api).then(setComments, () => {}); }, [boot.api]);
+  useEffect(reloadComments, [reloadComments]);
+  const addComment = useCallback<ViewerCtx["addComment"]>(async (c) => {
+    if (!boot.api) return;
+    const author = localStorage.getItem("recap.author") || "reader";
+    await commentsApi.add(boot.api, { ...c, author });
+    reloadComments();
+  }, [boot.api, reloadComments]);
+
+  // keys
+  useEffect(() => {
+    const on = (e: KeyboardEvent) => {
+      const t = e.target as HTMLElement;
+      if (t.closest?.("input, textarea, [contenteditable]") || e.metaKey || e.ctrlKey || e.altKey) return;
+      if (e.key >= "1" && e.key <= "4") setLevel((Number(e.key) - 1) as Level);
+      else if (e.key === "+" || e.key === "=") setLevel(clampLevel(level + 1));
+      else if (e.key === "-" || e.key === "_") setLevel(clampLevel(level - 1));
+      else if (e.key === "Escape" && focus) setFocus(null);
+      else if (e.key === "t") setThemePref(theme === "dark" ? "light" : "dark");
+      else if (e.key === "p" && doc.planLink) setOverlay((o) => !o);
+      else return;
+      e.preventDefault();
+    };
+    window.addEventListener("keydown", on);
+    return () => window.removeEventListener("keydown", on);
+  }, [level, focus, theme, setLevel, setFocus, doc.planLink]);
+
+  const toggleTheme = () => {
+    const next = theme === "dark" ? "light" : "dark";
+    setThemePref(next);
+    localStorage.setItem("recap.theme", next);
+  };
+
+  const ctx: ViewerCtx = { doc, getFile, level, setLevel, theme, focus, setFocus, revealFile, api: boot.api, comments, addComment };
+  const focused = focus ? doc.sections.find((s) => s.id === focus) : undefined;
+  const showOutline = level >= 2;
+
+  return (
+    <Ctx.Provider value={ctx}>
+      <TopBar doc={doc} theme={theme} toggleTheme={toggleTheme} overlay={overlay} setOverlay={setOverlay} />
+      <div className={cx("layout", showOutline && "with-outline", `lvl-${level}`)}>
+        {showOutline && <Outline />}
+        <main className="content">
+          {focused ? (
+            <FocusView sectionId={focused.id} overlay={overlay} />
+          ) : (
+            <>
+              <Headline overlay={overlay} setOverlay={setOverlay} />
+              {level === 0 && <NextLevel doc={doc} />}
+              {level >= 1 && <MapPanel overlay={overlay} />}
+              {level >= 2 && <Areas />}
+              {level >= 3 && <AllFiles />}
+            </>
+          )}
+        </main>
+      </div>
+    </Ctx.Provider>
+  );
+}
+
+function TopBar({ doc, theme, toggleTheme, overlay, setOverlay }: {
+  doc: Doc; theme: Theme; toggleTheme: () => void; overlay: boolean; setOverlay: (v: boolean) => void;
+}) {
+  const { level, setLevel } = useViewer();
+  return (
+    <div className="topbar">
+      <div className="tb-left">
+        <span className="tb-mark" aria-hidden><Icon name="layers" size={14} /></span>
+        <span className="tb-kind">{doc.kind === "plan" ? "VISUAL PLAN" : "VISUAL REVIEW"}</span>
+        <span className="tb-title" title={doc.title}>{doc.title}</span>
+      </div>
+      <div className="zoom" role="group" aria-label="Zoom level">
+        <button className="zbtn step" onClick={() => setLevel(clampLevel(level - 1))} disabled={level === 0} title="Zoom out (−)">
+          <Icon name="minus" size={13} />
+        </button>
+        <div className="zseg">
+          {LEVELS.map((l) => (
+            <button key={l.n} className={cx("zbtn", level === l.n && "on", level > l.n && "above")}
+              onClick={() => setLevel(l.n)} title={`${l.name} (key ${l.n + 1})`} aria-pressed={level === l.n}>
+              <span className="zdot">{l.n}</span>{l.name}
+            </button>
+          ))}
+        </div>
+        <button className="zbtn step" onClick={() => setLevel(clampLevel(level + 1))} disabled={level === 3} title="Zoom in (+)">
+          <Icon name="plus" size={13} />
+        </button>
+      </div>
+      <div className="tb-right">
+        {doc.planLink && level >= 1 && (
+          <button className={cx("btn small", overlay && "on")} onClick={() => setOverlay(!overlay)} title="Compare with plan (p)">
+            <Icon name="target" size={13} /> vs plan
+          </button>
+        )}
+        <button className="btn icon" onClick={toggleTheme} title="Toggle theme (t)" aria-label="Toggle theme">
+          <Icon name={theme === "dark" ? "sun" : "moon"} size={15} />
+        </button>
+      </div>
+    </div>
+  );
+}
+
+function NextLevel({ doc }: { doc: Doc }) {
+  const { setLevel } = useViewer();
+  const nodes = doc.map.nodes.filter((n) => n.change !== "unchanged").length;
+  return (
+    <button className="next-level" onClick={() => setLevel(1)}>
+      <span>Zoom in to the <b>map</b>: {plural(nodes, "changed area")}, {plural(doc.map.edges.length, "connection")}</span>
+      <span className="kbd">2</span>
+    </button>
+  );
+}
+
+function LevelRule({ n, note }: { n: number; note?: string }) {
+  return (
+    <div className="level-rule">
+      <span className="lr-tag">{n} · {LEVELS[n].name}</span>
+      {note && <span className="lr-note">{note}</span>}
+    </div>
+  );
+}
+
+function MapPanel({ overlay }: { overlay: boolean }) {
+  const { doc, level, setFocus } = useViewer();
+  // Overview = everything between the map and the first section. `questions` blocks are already the headline's ask.
+  const blocks = (doc.overviewBlocks ?? []).filter((b) => b.level <= level && b.type !== "questions");
+  return (
+    <section className="map-panel" id="map-panel">
+      <LevelRule n={1} note="hover a node for its summary · click to focus" />
+      <div className="card map-card">
+        <MapView overlay={overlay} onOpen={setFocus} />
+      </div>
+      {blocks.length > 0 ? (
+        <div className="overview">
+          {blocks.map((b) => (
+            <Commentable key={b.id} anchor={{ block: b.id }} className={cx("blk", `blk-${b.type}`)}>
+              <BlockView block={b} />
+            </Commentable>
+          ))}
+        </div>
+      ) : !doc.overviewBlocks && doc.overview ? <Markdown md={doc.overview} className="overview prose" /> : null}
+    </section>
+  );
+}
+
+function Areas() {
+  const { doc, level } = useViewer();
+  const secs = orderedSections(doc);
+  const main = secs.filter((s) => !s.mechanical);
+  const mech = secs.filter((s) => s.mechanical);
+  return (
+    <div className="areas">
+      <LevelRule n={2} note={`${plural(main.length, "area")}${mech.length ? ` · ${mech.length} mechanical` : ""}`} />
+      {main.map((s) => <SectionView key={s.id} section={s} level={level} />)}
+      {mech.length > 0 && (
+        <div className="mech-group">
+          <div className="mech-title muted">Mechanical changes</div>
+          {mech.map((s) => <SectionView key={s.id} section={s} level={level} />)}
+        </div>
+      )}
+    </div>
+  );
+}
+
+function AllFiles() {
+  const { doc } = useViewer();
+  if (doc.files.length === 0) return null;
+  const explicit = explicitDiffFiles(doc);
+  const covered = new Set([...explicit, ...doc.sections.flatMap((s) => autoFiles(doc, s.id).map((f) => f.path))]);
+  const rest = doc.files.filter((f) => !covered.has(f.path));
+  return (
+    <section className="all-files" id="all-files" data-section="all-files">
+      <LevelRule n={3} note={`all ${plural(doc.files.length, "changed file")}`} />
+      <div className="card pad">
+        <FileTree entries={doc.files.map((f) => ({ path: f.path, file: f }))} />
+      </div>
+      {rest.length > 0 && (
+        <div className="rest-files">
+          <div className="blk-label">Not covered by any area</div>
+          {rest.map((f) => <FileDiff key={f.path} file={f} defaultOpen={!f.mechanical} />)}
+        </div>
+      )}
+    </section>
+  );
+}
+
+function Outline() {
+  const { doc, level, focus, setFocus } = useViewer();
+  const secs = orderedSections(doc);
+  const [active, setActive] = useState<string | null>(null);
+  useEffect(() => {
+    if (focus) return;
+    const els = [...document.querySelectorAll<HTMLElement>("[data-section]")];
+    const io = new IntersectionObserver((entries) => {
+      const vis = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
+      if (vis[0]) setActive((vis[0].target as HTMLElement).dataset.section!);
+    }, { rootMargin: "-64px 0px -60% 0px" });
+    els.forEach((e) => io.observe(e));
+    return () => io.disconnect();
+  }, [focus, level, doc]);
+  const cur = focus ?? active;
+  const go = (id: string) => {
+    if (focus) { setFocus(id); return; }
+    document.getElementById(sectionDomId(id))?.scrollIntoView({ behavior: "smooth", block: "start" });
+  };
+  let mechStarted = false;
+  return (
+    <nav className="outline" aria-label="Sections">
+      <div className="ol-title">{focus ? "Areas" : "On this page"}</div>
+      {!focus && <a className="ol-item top" href="#headline" onClick={(e) => { e.preventDefault(); window.scrollTo({ top: 0, behavior: "smooth" }); }}>Headline</a>}
+      {!focus && <a className="ol-item top" href="#map-panel" onClick={(e) => { e.preventDefault(); document.getElementById("map-panel")?.scrollIntoView({ behavior: "smooth" }); }}>Map</a>}
+      {focus && <button className="ol-item top" onClick={() => setFocus(null)}><Icon name="arrowLeft" size={12} /> Map</button>}
+      <div className="ol-sep" />
+      {secs.map((s) => {
+        const n = nodeForSection(doc, s.id);
+        const head = s.mechanical && !mechStarted ? ((mechStarted = true), <div key="mh" className="ol-sub">Mechanical</div>) : null;
+        return [
+          head,
+          <button key={s.id} className={cx("ol-item", cur === s.id && "on", s.mechanical && "mech")} onClick={() => go(s.id)}>
+            <span className={cx("dot", n && `ch-${n.change}`)} />{s.title}
+          </button>,
+        ];
+      })}
+      {level >= 3 && !focus && doc.files.length > 0 && (
+        <>
+          <div className="ol-sep" />
+          <button className={cx("ol-item", cur === "all-files" && "on")} onClick={() => document.getElementById("all-files")?.scrollIntoView({ behavior: "smooth" })}>
+            All files <span className="muted">{doc.files.length}</span>
+          </button>
+        </>
+      )}
+      <div className="ol-keys muted">
+        <span><span className="kbd">1</span>–<span className="kbd">4</span> zoom</span>
+        {focus && <span><span className="kbd">Esc</span> back to map</span>}
+      </div>
+    </nav>
+  );
+}
+
+function FocusView({ sectionId, overlay }: { sectionId: string; overlay: boolean }) {
+  const { doc, level, setFocus } = useViewer();
+  const secs = orderedSections(doc);
+  const idx = secs.findIndex((s) => s.id === sectionId);
+  const section = secs[idx];
+  const node = nodeForSection(doc, sectionId);
+  const byId = (id: string) => doc.map.nodes.find((n) => n.id === id);
+  const incoming = node ? doc.map.edges.filter((e) => e.to === node.id).map((e) => ({ e, n: byId(e.from) })) : [];
+  const outgoing = node ? doc.map.edges.filter((e) => e.from === node.id).map((e) => ({ e, n: byId(e.to) })) : [];
+  const prev = secs[idx - 1], next = secs[idx + 1];
+
+  const Neighbour = ({ n, label, dir }: { n?: ReturnType<typeof byId>; label?: string; dir: "in" | "out" }) => {
+    if (!n) return null;
+    const has = n.section && doc.sections.some((s) => s.id === n.section);
+    const body = (
+      <>
+        <Icon name={dir === "in" ? "arrowLeft" : "arrowRight"} size={12} className="nb-arrow" />
+        <span className={cx("dot", `ch-${n.change}`)} />
+        <span className="nb-label">{n.label}</span>
+        {label && <span className="nb-edge">{label}</span>}
+      </>
+    );
+    return has
+      ? <button className="nb" onClick={() => setFocus(n.section!)}>{body}</button>
+      : <span className="nb ctx" title="context (unchanged)">{body}</span>;
+  };
+
+  return (
+    <div className="focus-view">
+      <nav className="crumbs">
+        <button className="crumb" onClick={() => setFocus(null)}><Icon name="arrowLeft" size={13} /> Map</button>
+        <span className="crumb-sep">›</span>
+        <span className="crumb cur">{section.title}</span>
+        <span className="sec-spacer" />
+        <span className="muted small">level {Math.max(level, 2)} · <span className="kbd">Esc</span> back</span>
+      </nav>
+      <div className="card focus-context">
+        <MapView compact focusSection={sectionId} overlay={overlay} onOpen={setFocus} />
+        {(incoming.length > 0 || outgoing.length > 0) && (
+          <div className="neighbours">
+            {incoming.length > 0 && (
+              <div className="nb-col"><div className="tile-label">Called by / fed from</div>
+                {incoming.map(({ e, n }, i) => <Neighbour key={i} n={n} label={e.label} dir="in" />)}</div>
+            )}
+            {outgoing.length > 0 && (
+              <div className="nb-col"><div className="tile-label">Calls / feeds</div>
+                {outgoing.map(({ e, n }, i) => <Neighbour key={i} n={n} label={e.label} dir="out" />)}</div>
+            )}
+          </div>
+        )}
+      </div>
+      <SectionView key={section.id} section={section} level={Math.max(level, 2) as Level} focused />
+      <div className="focus-nav">
+        {prev ? <button className="fn prev" onClick={() => setFocus(prev.id)}><span className="muted">← Previous</span>{prev.title}</button> : <span />}
+        {next ? <button className="fn next" onClick={() => setFocus(next.id)}><span className="muted">Next →</span>{next.title}</button> : <span />}
+      </div>
+    </div>
+  );
+}
diff --git a/viewer/src/app.css b/viewer/src/app.css
new file mode 100644
index 0000000..c42fba9
--- /dev/null
+++ b/viewer/src/app.css
@@ -0,0 +1,704 @@
+/* recap viewer styles. Colours/space/type come from Collie UI tokens (theme.css). */
+
+:root {
+  --page: var(--collie-color-surface);
+  --card: var(--collie-color-canvas);
+  --line: var(--collie-color-border-subtle);
+  --fg: var(--collie-color-fg);
+  --muted: var(--collie-color-fg-muted);
+  --mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
+  --r: var(--collie-radius-md);
+  --topbar-h: 52px;
+  --content-w: 860px;
+  --wide-w: 1040px;
+  --hl-kw: #a626a4; --hl-str: #2a7a3b; --hl-num: #b25c00; --hl-com: #8a8a8a; --hl-fn: #2f5fbf; --hl-type: #a15c00; --hl-attr: #9a3c00;
+  --diff-add-bg: color-mix(in srgb, var(--collie-color-success-subtle) 80%, transparent);
+  --diff-add-ln: var(--collie-color-success-subtle-hover);
+  --diff-del-bg: color-mix(in srgb, var(--collie-color-critical-subtle) 80%, transparent);
+  --diff-del-ln: var(--collie-color-critical-subtle-hover);
+  --purple: #8e4ec6; --purple-subtle: #f7edfe; --purple-border: #d19dff;
+}
+[data-theme="midnight"] {
+  --page: var(--collie-color-canvas);
+  --card: var(--collie-color-surface);
+  --hl-kw: #e38aed; --hl-str: #8fd19e; --hl-num: #f5b971; --hl-com: #7c7c7c; --hl-fn: #82b1ff; --hl-type: #f1c27d; --hl-attr: #f0a07a;
+  --diff-add-bg: color-mix(in srgb, var(--collie-color-success-subtle) 90%, transparent);
+  --diff-del-bg: color-mix(in srgb, var(--collie-color-critical-subtle) 90%, transparent);
+  --purple: #bf7af0; --purple-subtle: #2c1a3a; --purple-border: #6a3e8c;
+}
+
+* { box-sizing: border-box; }
+html { scroll-padding-top: calc(var(--topbar-h) + 16px); }
+body {
+  margin: 0; background: var(--page); color: var(--fg);
+  font-family: var(--collie-font-sans); font-size: 14px; line-height: 1.55;
+  -webkit-font-smoothing: antialiased;
+}
+button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
+button:disabled { cursor: default; }
+a { color: var(--collie-color-fg-accent); text-decoration: none; }
+a:hover { text-decoration: underline; }
+code, pre, .mono { font-family: var(--mono); font-size: 0.92em; }
+.muted { color: var(--muted); }
+.small { font-size: 12px; }
+.empty-state { padding: 80px; text-align: center; color: var(--muted); }
+.kbd {
+  display: inline-block; min-width: 18px; padding: 0 5px; border: 1px solid var(--collie-color-border);
+  border-bottom-width: 2px; border-radius: 4px; font: 500 11px/16px var(--mono); text-align: center; color: var(--muted);
+  background: var(--card);
+}
+
+/* ---------- buttons, pills, tags, badges */
+.btn {
+  display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 12px;
+  border: 1px solid var(--collie-color-border); border-radius: 7px; background: var(--card);
+  font-size: 13px; font-weight: 500; box-shadow: var(--collie-shadow-raised); white-space: nowrap;
+}
+.btn:hover { border-color: var(--collie-color-border-hover); background: var(--collie-color-neutral-subtle); }
+.btn.small { height: 26px; padding: 0 9px; font-size: 12px; }
+.btn.icon { width: 30px; padding: 0; justify-content: center; }
+.btn.ghost { border-color: transparent; box-shadow: none; background: none; }
+.btn.ghost:hover { background: var(--collie-color-neutral-subtle); }
+.btn.primary { background: var(--collie-color-accent-solid); border-color: transparent; color: var(--collie-color-fg-on-accent); }
+.btn.primary:hover { background: var(--collie-color-accent-solid-hover); }
+.btn.primary:disabled { opacity: .5; }
+.btn.on { background: var(--collie-color-accent-subtle); border-color: var(--collie-color-border-accent); color: var(--collie-color-fg-accent); }
+
+.pill {
+  display: inline-flex; align-items: center; height: 20px; padding: 0 8px; border-radius: 99px;
+  font-size: 11.5px; font-weight: 500; background: var(--collie-color-neutral-subtle); color: var(--muted);
+  border: 1px solid var(--line);
+}
+.pill.st-ready, .pill.st-accepted, .pill.st-done { background: var(--collie-color-success-subtle); color: var(--collie-color-fg-success); border-color: var(--collie-color-border-success); }
+.pill.st-draft, .pill.st-proposed { background: var(--collie-color-warning-subtle); color: var(--collie-color-fg-warning); border-color: var(--collie-color-border-warning); }
+.tag {
+  display: inline-flex; align-items: center; gap: 3px; height: 18px; padding: 0 6px; border-radius: 4px;
+  font-size: 11px; font-weight: 500; color: var(--muted); background: var(--collie-color-neutral-subtle); white-space: nowrap;
+}
+.tag.link { cursor: pointer; color: var(--collie-color-fg-accent); background: var(--collie-color-accent-subtle); }
+.badge {
+  display: inline-flex; align-items: center; height: 19px; padding: 0 7px; border-radius: 5px;
+  font-size: 11px; font-weight: 600; letter-spacing: .01em; border: 1px solid; white-space: nowrap;
+}
+.ch-added { --c-bg: var(--collie-color-success-subtle); --c-fg: var(--collie-color-fg-success); --c-bd: var(--collie-color-border-success); --c-solid: var(--collie-color-success-solid); }
+.ch-changed { --c-bg: var(--collie-color-warning-subtle); --c-fg: var(--collie-color-fg-warning); --c-bd: var(--collie-color-border-warning); --c-solid: var(--collie-color-warning-solid); }
+.ch-removed { --c-bg: var(--collie-color-critical-subtle); --c-fg: var(--collie-color-fg-critical); --c-bd: var(--collie-color-border-critical); --c-solid: var(--collie-color-critical-solid); }
+.ch-unchanged { --c-bg: var(--card); --c-fg: var(--muted); --c-bd: var(--collie-color-border); --c-solid: var(--collie-color-neutral-solid); }
+.ch-planned { --c-bg: var(--collie-color-accent-subtle); --c-fg: var(--collie-color-fg-accent); --c-bd: var(--collie-color-border-accent); --c-solid: var(--collie-color-accent-solid); }
+.ch-deferred { --c-bg: transparent; --c-fg: var(--muted); --c-bd: var(--collie-color-border-hover); --c-solid: var(--collie-color-neutral-solid); }
+.badge[class*="ch-"] { background: var(--c-bg); color: var(--c-fg); border-color: var(--c-bd); }
+.badge.ch-planned { border-style: dashed; }
+.badge.ch-deferred { border-style: dotted; }
+.dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--c-solid, var(--collie-color-neutral-solid)); flex: none; }
+.dot.ch-unchanged { background: none; border: 1.5px solid var(--collie-color-neutral-solid); }
+.dot.ch-planned { background: none; border: 1.5px dashed var(--collie-color-accent-solid); }
+.dot.ch-deferred { background: none; border: 1.5px dotted var(--collie-color-neutral-solid); }
+
+.adddel { font: 600 12px var(--mono); white-space: nowrap; }
+.adddel .add { color: var(--collie-color-fg-success); }
+.adddel .del { color: var(--collie-color-fg-critical); }
+.churn { display: inline-flex; gap: 2px; vertical-align: middle; }
+.churn i { width: 7px; height: 7px; border-radius: 1.5px; background: var(--collie-color-neutral-subtle-active); }
+.churn i.a { background: var(--collie-color-success-solid); }
+.churn i.d { background: var(--collie-color-critical-solid); }
+
+.fletter {
+  display: inline-grid; place-items: center; width: 17px; height: 17px; border-radius: 4px; flex: none;
+  font: 700 10px var(--mono); border: 1px solid;
+}
+.fl-A { color: var(--collie-color-fg-success); background: var(--collie-color-success-subtle); border-color: var(--collie-color-border-success); }
+.fl-M { color: var(--collie-color-fg-warning); background: var(--collie-color-warning-subtle); border-color: var(--collie-color-border-warning); }
+.fl-D { color: var(--collie-color-fg-critical); background: var(--collie-color-critical-subtle); border-color: var(--collie-color-border-critical); }
+.fl-R { color: var(--purple); background: var(--purple-subtle); border-color: var(--purple-border); }
+.fl-P { color: var(--collie-color-fg-accent); background: var(--collie-color-accent-subtle); border-color: var(--collie-color-border-accent); border-style: dashed; }
+
+.card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; }
+.card.pad { padding: 4px 0; }
+
+/* ---------- top bar */
+.topbar {
+  position: sticky; top: 0; z-index: 50; height: var(--topbar-h);
+  display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; padding: 0 16px;
+  background: color-mix(in srgb, var(--page) 82%, transparent); backdrop-filter: blur(12px) saturate(1.4);
+  border-bottom: 1px solid var(--line);
+}
+.tb-left { display: flex; align-items: center; gap: 10px; min-width: 0; }
+.tb-mark {
+  display: grid; place-items: center; width: 24px; height: 24px; border-radius: 7px; flex: none;
+  background: var(--fg); color: var(--page);
+}
+.tb-kind { font-size: 10.5px; font-weight: 700; letter-spacing: .09em; color: var(--muted); white-space: nowrap; }
+.tb-title { font-weight: 600; font-size: 13.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.tb-right { display: flex; justify-content: flex-end; align-items: center; gap: 8px; }
+
+.zoom { display: flex; align-items: center; gap: 4px; }
+.zseg {
+  display: flex; padding: 3px; gap: 2px; border-radius: 10px;
+  background: var(--collie-color-neutral-subtle); border: 1px solid var(--line);
+}
+.zbtn {
+  display: inline-flex; align-items: center; gap: 7px; height: 28px; padding: 0 12px 0 8px; border-radius: 7px;
+  font-size: 13px; font-weight: 500; color: var(--muted); transition: background .12s, color .12s;
+}
+.zbtn:hover:not(:disabled) { color: var(--fg); }
+.zbtn .zdot {
+  display: grid; place-items: center; width: 17px; height: 17px; border-radius: 5px;
+  font: 600 10.5px var(--mono); background: var(--collie-color-neutral-subtle-active); color: var(--muted);
+}
+.zbtn.above .zdot { background: var(--collie-color-accent-subtle-active); color: var(--collie-color-fg-accent); }
+.zbtn.on { background: var(--card); color: var(--fg); box-shadow: 0 1px 2px rgb(0 0 0 / .08), 0 0 0 1px var(--line); }
+.zbtn.on .zdot { background: var(--collie-color-accent-solid); color: var(--collie-color-fg-on-accent); }
+.zbtn.step { width: 28px; padding: 0; justify-content: center; border-radius: 7px; border: 1px solid transparent; }
+.zbtn.step:hover:not(:disabled) { background: var(--collie-color-neutral-subtle); }
+.zbtn.step:disabled { opacity: .35; }
+
+/* ---------- layout */
+.layout { display: grid; grid-template-columns: 1fr; justify-content: center; padding: 28px 24px 120px; }
+.layout.with-outline { grid-template-columns: 200px minmax(0, var(--wide-w)); gap: 40px; }
+.content { width: 100%; max-width: var(--wide-w); margin: 0 auto; min-width: 0; }
+.layout.lvl-0 .content { max-width: 760px; padding-top: 6vh; }
+.layout.lvl-1 .content { max-width: var(--wide-w); }
+
+/* level rules: the visible seams of the zoom ladder */
+.level-rule { display: flex; align-items: center; gap: 10px; margin: 40px 0 14px; color: var(--muted); font-size: 12px; }
+.level-rule::after { content: ""; flex: 1; height: 1px; background: var(--line); order: 3; }
+.lr-tag {
+  font: 600 11px var(--mono); letter-spacing: .04em; text-transform: uppercase; padding: 3px 8px; border-radius: 6px;
+  color: var(--collie-color-fg-accent); background: var(--collie-color-accent-subtle);
+}
+.lr-note { order: 2; }
+
+/* ---------- headline (level 0) */
+.headline {
+  background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 26px 30px 22px;
+  box-shadow: 0 1px 2px rgb(0 0 0 / .04);
+}
+.headline.solo { box-shadow: var(--collie-shadow-overlay); padding: 34px 38px 28px; }
+.hl-kicker { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 12px; color: var(--muted); }
+.hl-kicker .kind { font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--collie-color-fg-accent); }
+.hl-ref { display: inline-flex; align-items: center; gap: 5px; }
+.hl-ref code { font-size: 11.5px; padding: 1px 5px; border-radius: 4px; background: var(--collie-color-neutral-subtle); }
+.hl-ref.link { color: var(--muted); }
+.hl-ref.link:hover { color: var(--collie-color-fg-accent); }
+.hl-title { font-size: 30px; line-height: 1.2; letter-spacing: -.02em; margin: 14px 0 10px; font-weight: 650; text-wrap: balance; }
+.headline.solo .hl-title { font-size: 34px; }
+.hl-tldr { font-size: 17px; line-height: 1.5; margin: 0 0 22px; color: var(--fg); opacity: .88; text-wrap: pretty; }
+.hl-label {
+  display: inline-block; margin-right: 8px; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
+  color: var(--muted); vertical-align: 2px;
+}
+.hl-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; }
+.hl-tile { border: 1px solid var(--line); border-radius: 11px; padding: 12px 14px; background: var(--page); min-width: 0; }
+.tile-label { font-size: 11px; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
+.tile-text { font-size: 13px; line-height: 1.45; }
+.tile-text.strong { font-weight: 500; font-size: 14px; }
+.hl-tile.ask { background: var(--collie-color-accent-subtle); border-color: var(--collie-color-border-accent); }
+.hl-tile.ask .tile-label { color: var(--collie-color-fg-accent); }
+.risk-level { display: flex; align-items: center; gap: 7px; font-weight: 650; font-size: 15px; text-transform: capitalize; margin-bottom: 4px; }
+.risk-dot { width: 9px; height: 9px; border-radius: 50%; }
+.risk-low .risk-dot { background: var(--collie-color-success-solid); }
+.risk-low .risk-level { color: var(--collie-color-fg-success); }
+.risk-medium .risk-dot { background: var(--collie-color-warning-solid); }
+.risk-medium .risk-level { color: var(--collie-color-fg-warning); }
+.risk-high .risk-dot { background: var(--collie-color-critical-solid); }
+.risk-high .risk-level { color: var(--collie-color-fg-critical); }
+.hl-tile.risk-high { background: var(--collie-color-critical-subtle); border-color: var(--collie-color-border-critical); }
+.stat-big { display: flex; align-items: baseline; gap: 10px; font-weight: 650; font-size: 15px; margin-bottom: 6px; }
+.stat-big .adddel { font-size: 13px; }
+.hl-tile.stats .churn { margin-bottom: 6px; }
+.plan-strip {
+  display: flex; align-items: center; flex-wrap: wrap; gap: 6px 14px; margin-top: 12px; padding: 9px 14px;
+  border-radius: 10px; border: 1px dashed var(--collie-color-border-accent); font-size: 13px; color: var(--muted);
+}
+.plan-strip b { color: var(--fg); font-weight: 600; }
+.plan-strip .btn { margin-left: auto; }
+.hl-decisions { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--line); }
+.hl-foot { margin-top: 18px; font-size: 12px; }
+.hl-warnings { margin-top: 10px; font-size: 12px; color: var(--collie-color-fg-warning); }
+.next-level {
+  display: flex; align-items: center; justify-content: space-between; width: 100%; margin-top: 14px; padding: 12px 18px;
+  border: 1px dashed var(--collie-color-border); border-radius: 12px; color: var(--muted); font-size: 13px;
+}
+.next-level:hover { border-color: var(--collie-color-border-accent); color: var(--fg); background: var(--card); }
+.next-level b { color: var(--fg); }
+
+/* plan marks */
+.pm-text { display: inline-flex; align-items: center; gap: 5px; font-weight: 500; }
+.pm-text::before { content: ""; width: 8px; height: 8px; border-radius: 50%; }
+.pm-done { --pm: var(--collie-color-success-solid); }
+.pm-notDone { --pm: var(--collie-color-warning-solid); }
+.pm-unplanned { --pm: var(--purple); }
+.pm-deferred { --pm: var(--collie-color-neutral-solid); }
+.pm-text.pm-deferred { color: var(--muted); }
+.pm-text::before, .pm-sw { background: var(--pm); }
+.pm-text.pm-notDone::before, .pm-sw.pm-notDone { background: none; border: 2px solid var(--pm); }
+.pm-text.pm-done { color: var(--collie-color-fg-success); }
+.pm-text.pm-notDone { color: var(--collie-color-fg-warning); }
+.pm-text.pm-unplanned { color: var(--purple); }
+
+/* ---------- questions */
+.questions { display: grid; gap: 10px; }
+.question { padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
+.questions.compact .question { background: var(--page); padding: 10px 12px; }
+.q-text { display: flex; gap: 10px; font-weight: 550; font-size: 14px; align-items: baseline; }
+.q-num {
+  flex: none; display: grid; place-items: center; width: 20px; height: 20px; border-radius: 6px; font: 600 11px var(--mono);
+  background: var(--purple-subtle); color: var(--purple); transform: translateY(-1px);
+}
+.q-options { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 0 30px; }
+.q-opt {
+  display: inline-flex; align-items: center; gap: 4px; padding: 3px 9px; border-radius: 7px; font-size: 12.5px;
+  border: 1px solid var(--collie-color-border); background: var(--card);
+}
+.q-opt.rec { border-color: var(--collie-color-border-success); background: var(--collie-color-success-subtle); color: var(--collie-color-fg-success); font-weight: 550; }
+.q-why, .q-rec { margin: 6px 0 0 30px; font-size: 12.5px; color: var(--muted); }
+
+/* ---------- map */
+.map-panel .map-card { padding: 6px; overflow: visible; }
+.map { position: relative; }
+.map-scroll { overflow-x: auto; display: flex; justify-content: center; padding: 8px; }
+.map-svg { display: block; max-width: 100%; height: auto; overflow: visible; }
+
+.map-loading { border-radius: 10px; background: linear-gradient(90deg, var(--page), var(--collie-color-neutral-subtle), var(--page)); background-size: 200% 100%; animation: shimmer 1.2s infinite; }
+@keyframes shimmer { to { background-position: -200% 0; } }
+.map-err { padding: 20px; color: var(--collie-color-fg-critical); }
+
+.mgroup rect { fill: color-mix(in srgb, var(--collie-color-neutral-subtle) 55%, transparent); stroke: var(--line); stroke-width: 1; }
+.mgroup text { font: 600 10.5px var(--collie-font-sans); letter-spacing: .08em; fill: var(--muted); }
+
+.medge-line { fill: none; stroke-width: 1.5; stroke: var(--collie-color-neutral-solid); transition: stroke-width .12s, opacity .12s; }
+.medge-hit { fill: none; stroke: transparent; stroke-width: 12; pointer-events: stroke; }
+.medge { transition: opacity .15s; }
+.medge.ech-added .medge-line { stroke: var(--collie-color-success-solid); }
+.medge.ech-changed .medge-line { stroke: var(--collie-color-warning-solid); }
+.medge.ech-removed .medge-line { stroke: var(--collie-color-critical-solid); stroke-dasharray: 5 4; }
+.medge.ech-planned .medge-line { stroke: var(--collie-color-accent-solid); stroke-dasharray: 5 4; }
+.medge.ech-unchanged .medge-line { stroke: var(--collie-color-border-hover); }
+.medge.ech-deferred .medge-line { stroke: var(--collie-color-border-hover); stroke-dasharray: 1.5 3.5; stroke-linecap: round; }
+.medge.active .medge-line { stroke-width: 2.4; }
+.map.hovering .medge:not(.active), .map.hovering .medge-label:not(.active) { opacity: .3; }
+.arrowhead { stroke: none; fill: var(--collie-color-border-hover); }
+.arrowhead.ech-added { fill: var(--collie-color-success-solid); }
+.arrowhead.ech-changed { fill: var(--collie-color-warning-solid); }
+.arrowhead.ech-removed { fill: var(--collie-color-critical-solid); }
+.arrowhead.ech-planned { fill: var(--collie-color-accent-solid); }
+.medge-label { pointer-events: none; transition: opacity .15s; }
+.medge-label rect { fill: var(--card); stroke: var(--line); }
+.medge-label text { font: 400 11px var(--collie-font-sans); fill: var(--muted); }
+.medge-label.ech-added text { fill: var(--collie-color-fg-success); }
+.medge-label.ech-removed text { fill: var(--collie-color-fg-critical); text-decoration: line-through; }
+.medge-label.ech-planned text { fill: var(--collie-color-fg-accent); }
+.medge-label.ech-changed text { fill: var(--collie-color-fg-warning); }
+.medge-label.ech-deferred text { font-style: italic; }
+.medge-label.active rect { stroke: var(--collie-color-border-hover); }
+.medge-label.floating rect { filter: drop-shadow(0 1px 3px rgb(0 0 0 / .15)); }
+.medge-label.dim { opacity: .22; }
+
+.mnode { outline: none; transition: opacity .15s; }
+.mnode .mnode-box { fill: var(--c-bg); stroke: var(--c-bd); stroke-width: 1.4; transition: stroke-width .1s; }
+.mnode.ch-unchanged .mnode-box { stroke-dasharray: 4 3; }
+.mnode.ch-planned .mnode-box { stroke-dasharray: 5 3; stroke-width: 1.6; }
+.mnode.ch-deferred .mnode-box { stroke-dasharray: 1.5 3; stroke-linecap: round; stroke-width: 1.6; }
+.mnode.ch-deferred .mnode-label { fill: var(--muted); font-style: italic; }
+.mnode.ch-deferred .mnode-icon path { stroke: var(--muted); }
+.mnode .mnode-icon path { fill: none; stroke: var(--c-fg); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
+.mnode .mnode-label { font: 500 13px var(--collie-font-sans); fill: var(--fg); }
+.mnode.ch-unchanged .mnode-label { fill: var(--muted); }
+.mnode.ch-removed .mnode-label { text-decoration: line-through; fill: var(--collie-color-fg-critical); }
+.mnode.mech { opacity: .5; }
+.mnode.mech .mnode-box { fill: var(--collie-color-neutral-subtle); stroke: var(--collie-color-border); }
+.mnode.mech .mnode-icon path { stroke: var(--muted); }
+.mnode.clickable { cursor: pointer; }
+.mnode.clickable:hover .mnode-box, .mnode.clickable:focus-visible .mnode-box { stroke-width: 2.4; filter: drop-shadow(0 2px 6px rgb(0 0 0 / .12)); }
+.mnode .focus-ring { fill: none; stroke: var(--collie-color-accent-solid); stroke-width: 2; }
+.mnode.dim, .medge.dim { opacity: .22; }
+.mgroup.dim-soft { opacity: .6; }
+.pmark circle { fill: var(--pm); stroke: var(--card); stroke-width: 2; }
+.pmark path { fill: none; stroke: #fff; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
+.pmark.pm-notDone circle { fill: var(--card); stroke: var(--pm); stroke-width: 2; }
+.pmark.pm-notDone path { stroke: var(--pm); }
+
+.map-tip {
+  position: absolute; z-index: 20; width: 330px; transform: translate(-50%, -100%); pointer-events: none;
+  background: var(--card); border: 1px solid var(--collie-color-border); border-radius: 10px;
+  box-shadow: var(--collie-shadow-overlay); padding: 10px 12px; font-size: 12.5px;
+}
+.map-tip.below { transform: translate(-50%, 0); }
+.tip-head { display: flex; align-items: center; gap: 7px; margin-bottom: 4px; }
+.tip-head b { font-size: 13px; }
+.tip-head .muted { margin-left: auto; font-size: 11.5px; white-space: nowrap; }
+.tip-body p { margin: 0; }
+.tip-body { line-height: 1.45; }
