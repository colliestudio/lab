+-
+-	"github.com/acme/relay/internal/deliverymq"
+-	"github.com/acme/relay/internal/models"
+-)
+-
+-// LegacyRetry re-enqueues every failed attempt from the last hour, every
+-// 5 minutes. No backoff, no cap: a dead endpoint gets 12 attempts an hour forever.
+-func LegacyRetry(ctx context.Context, store models.AttemptStore, q deliverymq.Publisher) error {
+-	failed, err := store.FailedSince(ctx, time.Now().Add(-time.Hour))
+-	if err != nil {
+-		return err
+-	}
+-	for _, a := range failed {
+-		_ = q.Publish(ctx, a.Delivery())
+-	}
+-	return nil
+-}
