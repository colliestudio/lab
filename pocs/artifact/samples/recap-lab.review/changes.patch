++// Attempt 1 is the first retry (the original delivery is attempt 0).
++type Policy struct {
++	Base        time.Duration // delay before the first retry
++	Max         time.Duration // cap for a single delay
++	MaxAttempts int           // give up after this many retries
++}
++
++// DefaultPolicy: 30s, 1m, 2m, 4m ... capped at 1h, 12 retries (~9h total).
++var DefaultPolicy = Policy{
++	Base:        30 * time.Second,
++	Max:         time.Hour,
++	MaxAttempts: 12,
++}
++
++// Delay returns how long to wait before retry `attempt`, or ok=false when
++// the policy is exhausted and the delivery should be marked failed.
++func (p Policy) Delay(attempt int) (d time.Duration, ok bool) {
++	if attempt < 1 || attempt > p.MaxAttempts {
++		return 0, false
++	}
++	exp := float64(p.Base) * math.Pow(2, float64(attempt-1))
++	if exp > float64(p.Max) {
++		exp = float64(p.Max)
++	}
++	// full jitter: uniform in [exp/2, exp] keeps retries spread without
++	// collapsing to near-zero delays.
++	half := exp / 2
++	return time.Duration(half + rand.Float64()*half), true
++}
++
++// Exhausted reports whether no retries are left after `attempt`.
++func (p Policy) Exhausted(attempt int) bool { return attempt >= p.MaxAttempts }
