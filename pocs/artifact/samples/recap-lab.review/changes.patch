++            label="Room type"
++            defaultValue="deluxe"
++            options={[
++              { value: "deluxe", label: "Deluxe king" },
++              { value: "twin", label: "Twin" },
++            ]}
++          />
++        </Stack>
++      </Box>
++
++      <Table>
