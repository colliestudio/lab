++	for attempt := 1; attempt <= 10; attempt++ {
++		d, ok := p.Delay(attempt)
++		if !ok {
++			t.Fatalf("attempt %d: want ok", attempt)
++		}
++		if d > p.Max {
++			t.Fatalf("attempt %d: delay %s over cap %s", attempt, d, p.Max)
++		}
++		if d <= 0 {
