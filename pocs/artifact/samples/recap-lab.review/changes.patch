+        warn(`line ${tok.line}: duplicate section id "${id}"`);
+        let n = 2;
+        while (sectionIds.has(`${id}-${n}`)) n++;
+        id = `${id}-${n}`;
+      }
+      sectionIds.add(id);
+      section = { id, title: tok.title, summary: "", mechanical: tok.attrs.mechanical === "true", blocks: [], _counts: {} };
+      doc.sections.push(section);
+      continue;
+    }
+
+    if (tok.t === "text") {
+      if (!section) {
