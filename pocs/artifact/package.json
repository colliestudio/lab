{
  "name": "recap-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "recap": "bin/recap.js",
    "artifact": "bin/artifact.js"
  },
  "scripts": {
    "recap": "tsx src/cli.ts",
    "viewer:dev": "vite --config viewer/vite.config.ts",
    "viewer:build": "vite build --config viewer/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "artifact": "tsx artifact/cli/run.ts"
  },
  "dependencies": {
    "@mdx-js/esbuild": "^3.1.1",
    "dompurify": "^3.4.16",
    "elkjs": "^0.12.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "mermaid": "^12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rrweb-player": "1.0.0-alpha.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "sideEffects": [
    "*.css"
  ]
}
