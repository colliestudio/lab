--- /dev/null
+++ b/internal/delivery/retry_test.go
@@ -0,0 +1,23 @@
+package delivery
+
+import (
+	"testing"
+	"time"
+)
+
+func TestNextIsCapped(t *testing.T) {
+	r := DefaultRetry()
+	now := time.Unix(0, 0)
+	for attempt := 0; attempt < r.MaxAttempts; attempt++ {
+		at, ok := r.Next(attempt, now)
+		if !ok {
+			t.Fatalf("attempt %d: want ok", attempt)
+		}
+		if at.Sub(now) > r.Cap {
+			t.Fatalf("attempt %d: delay %s over cap", attempt, at.Sub(now))
+		}
+	}
+	if _, ok := r.Next(r.MaxAttempts, now); ok {
+		t.Fatal("want exhausted")
+	}
+}
