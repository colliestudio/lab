@@ -0,0 +1,31 @@
+package delivery
+
+import (
+	"math/rand/v2"
+	"time"
+)
+
+// RetryScheduler decides when (and whether) a failed delivery is tried again:
+// capped exponential backoff with full jitter.
+type RetryScheduler struct {
+	Base        time.Duration // first delay, default 30s
+	Cap         time.Duration // longest delay, default 1h
+	MaxAttempts int           // give up after this many attempts, default 8
+}
+
+func DefaultRetry() *RetryScheduler {
+	return &RetryScheduler{Base: 30 * time.Second, Cap: time.Hour, MaxAttempts: 8}
+}
+
+// Next returns when attempt+1 should run, or ok=false when attempts are exhausted.
+func (r *RetryScheduler) Next(attempt int, now time.Time) (at time.Time, ok bool) {
+	if attempt >= r.MaxAttempts {
+		return time.Time{}, false
+	}
+	d := r.Base << attempt
+	if d <= 0 || d > r.Cap {
+		d = r.Cap
+	}
+	jitter := time.Duration(rand.Int64N(int64(d)))
+	return now.Add(jitter), true
+}
