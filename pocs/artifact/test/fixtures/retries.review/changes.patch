--- /dev/null
+++ b/web/src/pages/FailedDeliveries.tsx
@@ -0,0 +1,40 @@
+import { useEffect, useState } from "react";
+import { api, type Delivery } from "../api";
+
+export function FailedDeliveries() {
+  const [items, setItems] = useState<Delivery[]>([]);
+  const [busy, setBusy] = useState<string | null>(null);
+
+  useEffect(() => {
+    api.get<Delivery[]>("/deliveries?status=failed").then(setItems);
+  }, []);
+
+  async function replay(id: string) {
+    setBusy(id);
+    try {
+      await api.post(`/deliveries/${id}/replay`);
+      setItems((xs) => xs.filter((x) => x.id !== id));
+    } finally {
+      setBusy(null);
+    }
+  }
+
+  return (
+    <table className="table">
+      <thead>
+        <tr><th>Event</th><th>Destination</th><th>Attempts</th><th>Last status</th><th /></tr>
+      </thead>
+      <tbody>
+        {items.map((d) => (
+          <tr key={d.id}>
+            <td>{d.eventId}</td>
+            <td>{d.destination}</td>
+            <td>{d.attempts}</td>
+            <td><span className="badge">{d.lastStatus}</span></td>
+            <td><button disabled={busy === d.id} onClick={() => replay(d.id)}>Replay</button></td>
+          </tr>
+        ))}
+      </tbody>
+    </table>
+  );
+}
