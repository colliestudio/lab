diff --git a/internal/store/attempts.go b/internal/store/attempts.go
new file mode 100644
index 0000000..1234839
--- /dev/null
+++ b/internal/store/attempts.go
@@ -0,0 +1,44 @@
+package store
+
+import (
+	"context"
+	"database/sql"
+	"time"
+)
+
+type Attempt struct {
+	EventID string
+	Number  int
+	Status  int
+	Error   string
+	At      time.Time
+}
+
+type Attempts struct{ db *sql.DB }
+
+func NewAttempts(db *sql.DB) *Attempts { return &Attempts{db: db} }
+
+func (a *Attempts) Record(ctx context.Context, at Attempt) error {
+	_, err := a.db.ExecContext(ctx,
+		`INSERT INTO delivery_attempts (event_id, attempt, status, error, created_at) VALUES ($1, $2, $3, $4, $5)`,
+		at.EventID, at.Number, at.Status, at.Error, at.At)
+	return err
+}
+
+func (a *Attempts) ForEvent(ctx context.Context, eventID string) ([]Attempt, error) {
+	rows, err := a.db.QueryContext(ctx,
+		`SELECT event_id, attempt, status, error, created_at FROM delivery_attempts WHERE event_id = $1 ORDER BY attempt`, eventID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var out []Attempt
+	for rows.Next() {
+		var at Attempt
+		if err := rows.Scan(&at.EventID, &at.Number, &at.Status, &at.Error, &at.At); err != nil {
+			return nil, err
+		}
+		out = append(out, at)
+	}
+	return out, rows.Err()
+}
