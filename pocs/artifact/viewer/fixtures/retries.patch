@@ -58,37 +61,52 @@ func (c *Consumer) Handle(ctx context.Context, msg Message) error {
 	d, err := msg.Delivery()
 	if err != nil {
 		c.log.Error("bad delivery message", "err", err)
 		return msg.Ack() // poison message: never retry
 	}

 	dest, err := c.registry.Get(ctx, d.TenantID, d.DestinationID)
 	if err != nil {
 		return msg.Nack()
 	}

 	start := time.Now()
 	res, sendErr := dest.Publish(ctx, d.Event)
 	elapsed := time.Since(start)

 	attempt := models.Attempt{
 		DeliveryID: d.ID,
 		Number:     d.Attempt,
 		Status:     res.Status,
 		Latency:    elapsed,
 		Response:   res.Body,
 		CreatedAt:  start,
 	}
 	if sendErr != nil {
 		attempt.Error = sendErr.Error()
 	}

 	// Attempts are best-effort: a failed insert must not block delivery.
 	if err := c.attempts.Insert(ctx, attempt); err != nil {
 		c.log.Warn("record attempt", "delivery", d.ID, "err", err)
 	}

-	if sendErr != nil {
-		return msg.Nack()
+	if sendErr == nil {
+		c.metrics.Delivered.Inc()
+		return msg.Ack()
 	}
-	return msg.Ack()
+
+	// Failed: hand the delivery to the retry scheduler, then ack the original.
+	// Ack only after the retry is safely queued, so a crash in between re-delivers
+	// (a duplicate attempt) instead of dropping the event.
+	outcome, at, err := c.retries.Schedule(ctx, d)
+	if err != nil {
+		c.log.Error("schedule retry", "delivery", d.ID, "err", err)
+		return msg.Nack()
+	}
+	switch outcome {
+	case retry.Scheduled:
+		c.metrics.Retried.Inc()
+		c.log.Info("retry scheduled", "delivery", d.ID, "attempt", d.Attempt+1, "at", at)
+	case retry.GaveUp:
+		c.metrics.Failed.Inc()
+		if err := c.attempts.MarkFailed(ctx, d.ID); err != nil {
+			c.log.Warn("mark failed", "delivery", d.ID, "err", err)
+		}
+	}
+	return msg.Ack()
 }
