--- /dev/null
+++ b/internal/retry/scheduler.go
@@ -0,0 +1,52 @@
+package retry
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/acme/relay/internal/deliverymq"
+	"github.com/acme/relay/internal/models"
+)
+
+// Scheduler re-enqueues failed deliveries after their backoff delay.
+// It relies on the queue's native delayed publish, so there is no
+// polling loop and no extra table to scan.
+type Scheduler struct {
+	queue  deliverymq.Publisher
+	policy Policy
+	now    func() time.Time
+}
+
+func NewScheduler(q deliverymq.Publisher, p Policy) *Scheduler {
+	return &Scheduler{queue: q, policy: p, now: time.Now}
+}
+
+// Outcome tells the consumer what happened to a failed delivery.
+type Outcome int
+
+const (
+	Scheduled Outcome = iota // a retry is queued
+	GaveUp                   // policy exhausted; mark the delivery failed
+)
+
+// Schedule queues the next attempt for d, or reports GaveUp.
+func (s *Scheduler) Schedule(ctx context.Context, d models.Delivery) (Outcome, time.Time, error) {
+	next := d.Attempt + 1
+	delay, ok := s.policy.Delay(next)
+	if !ok {
+		return GaveUp, time.Time{}, nil
+	}
+	at := s.now().Add(delay)
+	msg := d.WithAttempt(next)
+	if err := s.queue.PublishAt(ctx, msg, at); err != nil {
+		return 0, time.Time{}, fmt.Errorf("retry: publish attempt %d of %s: %w", next, d.ID, err)
+	}
+	return Scheduled, at, nil
+}
+
+// Replay queues an immediate attempt for a delivery that already gave up.
+// Used by the operator API; it does not reset the attempt counter.
+func (s *Scheduler) Replay(ctx context.Context, d models.Delivery) error {
+	return s.queue.PublishAt(ctx, d.WithAttempt(d.Attempt+1), s.now())
+}
