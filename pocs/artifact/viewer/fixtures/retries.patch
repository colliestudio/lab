+package api
+
+import (
+	"net/http"
+
+	"github.com/acme/relay/internal/models"
+	"github.com/acme/relay/internal/retry"
+)
+
+type FailedDeliveriesHandler struct {
+	attempts models.AttemptStore
+	retries  *retry.Scheduler
+}
+
+// GET /tenants/{tenant}/deliveries/failed?cursor=&limit=
+func (h *FailedDeliveriesHandler) List(w http.ResponseWriter, r *http.Request) {
+	tenant := r.PathValue("tenant")
+	page, err := h.attempts.ListFailed(r.Context(), tenant, cursorFrom(r))
+	if err != nil {
+		writeError(w, err)
+		return
+	}
+	writeJSON(w, http.StatusOK, page)
+}
+
+// POST /tenants/{tenant}/deliveries/{id}/replay
+func (h *FailedDeliveriesHandler) Replay(w http.ResponseWriter, r *http.Request) {
+	tenant, id := r.PathValue("tenant"), r.PathValue("id")
+	d, err := h.attempts.GetDelivery(r.Context(), tenant, id)
+	if err != nil {
+		writeError(w, err)
+		return
+	}
+	if d.FailedAt == nil {
+		writeError(w, errConflict("delivery has not failed"))
+		return
+	}
+	if err := h.retries.Replay(r.Context(), d); err != nil {
+		writeError(w, err)
+		return
+	}
+	writeJSON(w, http.StatusAccepted, map[string]string{"status": "queued"})
+}
+
