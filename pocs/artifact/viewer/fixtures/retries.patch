@@ -0,0 +1,30 @@
+package retry
+
+import (
+	"testing"
+	"time"
+)
+
+func TestDelayIsCappedAndJittered(t *testing.T) {
+	p := Policy{Base: time.Second, Max: 8 * time.Second, MaxAttempts: 10}
+	for attempt := 1; attempt <= 10; attempt++ {
+		d, ok := p.Delay(attempt)
+		if !ok {
+			t.Fatalf("attempt %d: want ok", attempt)
+		}
+		if d > p.Max {
+			t.Fatalf("attempt %d: delay %s over cap %s", attempt, d, p.Max)
+		}
+		if d <= 0 {
+			t.Fatalf("attempt %d: non-positive delay", attempt)
+		}
+	}
+}
+
+func TestDelayExhausted(t *testing.T) {
+	p := Policy{Base: time.Second, Max: time.Minute, MaxAttempts: 3}
+	if _, ok := p.Delay(4); ok {
+		t.Fatal("attempt 4 of 3: want exhausted")
+	}
+}
+
