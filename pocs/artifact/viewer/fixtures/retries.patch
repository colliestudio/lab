@@ -0,0 +1,38 @@
+import { useState } from "react";
+import { useFailedDeliveries, replayDelivery } from "../api/deliveries";
+import { Table, Button, EmptyState, RelativeTime } from "../ui";
+
+export function FailedDeliveries({ tenant }: { tenant: string }) {
+  const { data, isLoading, refetch } = useFailedDeliveries(tenant);
+  const [busy, setBusy] = useState<string | null>(null);
+
+  if (isLoading) return <Table.Skeleton rows={5} />;
+  if (!data?.items.length) return <EmptyState title="No failed deliveries" />;
+
+  const replay = async (id: string) => {
+    setBusy(id);
+    try {
+      await replayDelivery(tenant, id);
+      await refetch();
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  return (
+    <Table>
+      {data.items.map((d) => (
+        <Table.Row key={d.id}>
+          <Table.Cell mono>{d.destination}</Table.Cell>
+          <Table.Cell>{d.lastError}</Table.Cell>
+          <Table.Cell>{d.attempts} attempts</Table.Cell>
+          <Table.Cell><RelativeTime value={d.failedAt} /></Table.Cell>
+          <Table.Cell align="end">
+            <Button size="sm" loading={busy === d.id} onClick={() => replay(d.id)}>Replay</Button>
+          </Table.Cell>
+        </Table.Row>
+      ))}
+    </Table>
+  );
+}
+
