  "questions": [
   {
    "q": "Backoff caps?",
    "options": [
     "12 retries / ~9 h",
     "8 retries / ~3 h",
     "18 retries / ~3 days"
    ],
    "recommend": "12 retries / ~9 h",
    "why": "Covers an outage window without keeping dead endpoints alive overnight."
   },
   {
    "q": "Alert tenants when a delivery gives up?",
    "options": [
     "Not now",
     "Webhook event",
     "Email"
    ],
    "recommend": "Not now",
    "why": "The Failed page covers operators; tenant alerts can follow once we see volumes."
   }
