{
  "name": "canvas-poc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n app,signal,sandbox -c green,blue,magenta \"vite --port 5190 --strictPort\" \"pnpm dev:signal\" \"pnpm dev:sandbox\"",
    "dev:app": "vite --port 5190 --strictPort",
    "dev:signal": "wrangler dev --config signaling/wrangler.toml --port 5192",
    "build": "pnpm typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p signaling",
    "test": "vitest run",
    "preview": "vite preview --port 5190 --strictPort",
    "deploy": "pnpm build && wrangler deploy --config signaling/wrangler.deploy.toml",
    "dev:sandbox": "node sandbox/server.mjs --port 5227"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "concurrently": "^10.0.6",
    "happy-dom": "^20.14.6",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.33"
  }
}
