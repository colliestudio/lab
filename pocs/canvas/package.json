{
  "name": "canvas-poc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n app,signal -c green,blue \"vite --port 5190 --strictPort\" \"pnpm dev:signal\"",
    "dev:app": "vite --port 5190 --strictPort",
    "dev:signal": "wrangler dev --config signaling/wrangler.toml --port 5192",
    "build": "pnpm typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p signaling && tsc --noEmit -p bridge",
    "test": "vitest run",
    "preview": "vite preview --port 5190 --strictPort",
    "deploy": "pnpm build && wrangler deploy --config signaling/wrangler.deploy.toml",
    "bridge": "tsx bridge/server.ts",
    "canvas": "tsx bridge/cli.ts",
    "canvas-mcp": "tsx bridge/mcp.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "happy-dom": "^20.14.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "lib0": "^0.2.119",
    "ws": "^8.22.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "y-webrtc": "^10.3.0",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  }
}
