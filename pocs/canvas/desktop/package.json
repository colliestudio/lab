{
  "name": "canvas-desktop",
  "private": true,
  "version": "0.2.0",
  "description": "Collie Canvas desktop (Electron): a window shell over a canvas serve",
  "main": "build/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "package": "node build.mjs && electron-builder --dir --mac --arm64",
    "publish-app": "node scripts/publish.mjs",
    "test:e2e": "node build.mjs && node test/desktop.e2e.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  }
}
