{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Canvas",
  "version": "0.1.0",
  "identifier": "studio.collie.canvas.spike",
  "build": {
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self' tauri: asset:; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:*; img-src 'self' data: blob: http: https:; style-src 'self' 'unsafe-inline'; frame-src http: https:; script-src 'self'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/canvas-service"],
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["canvas"],
        "name": "JSON Canvas",
        "description": "JSON Canvas board",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
